# Anthropic Claude: JARVIS's brain (claude-opus-5-5, see config.py)
ANTHROPIC_API_KEY=

# Google Gemini: the domain agents
GOOGLE_GENAI_API_KEY=
# Gemini model for the domain agents, e.g. gemini-3.5-flash
JARVIS_MODEL=
# Optional: model for the domain agents (defaults to JARVIS_MODEL). A small, fast one is ideal, e.g. gemini-3.5-flash-lite
JARVIS_AGENT_MODEL=

# Spotify (developer app; the redirect URI must match one registered on the app)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# Apple iCloud calendar (use an app-specific password from appleid.apple.com)
APPLE_ACCOUNT_EMAIL=
APPLE_CALENDAR_PASSWORD=
